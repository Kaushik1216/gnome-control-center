<?xml version="1.0"?>
<interface>
  <requires lib="gtk+" version="3.12"/>
  <template class="PpAppPrinterDialog" parent="GtkDialog">
    <property name="title" translatable="yes">Add CUPS-IPP printer</property>
    <property name="default-width">450</property>
    <property name="modal">True</property>
    <property name="destroy-with-parent">True</property>
    <property name="use-header-bar">1</property>

    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="spacing">24</property>

        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>

            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Choose an option how to set up this printer.</property>
                <property name="xalign">0</property>
                <style>
                  <class name="title-4"/>
                </style>
              </object>
            </child>

            <child>
              <object class="GtkListBox">
                <property name="selection-mode">none</property>
                <style>
                  <class name="boxed-list"/>
                </style>

                <!-- Option 1: Already installed printer -->
                <child>
                  <object class="GtkListBoxRow">
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="GtkCheckButton" id="option_installed">
                            <property name="active">True</property>
                            <accessibility>
                              <property name="label" translatable="yes">Select an already installed printer application</property>
                            </accessibility>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Select an already installed printer application</property>
                                <property name="xalign">0</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDropDown" id="printer_app_dropdown">
                                <property name="sensitive" bind-source="option_installed" bind-property="active" bind-flags="sync-create"/>
                                <property name="model">
                                  <object class="GtkStringList">
                                    <items>
                                      <item>HPLIP Printer Application</item>
                                      <item>Gutenprinter Printer Application</item>
                                    </items>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Option 2: Internet printer -->
                <child>
                  <object class="GtkListBoxRow">
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="GtkCheckButton" id="option_internet">
                            <property name="group">option_installed</property>
                            <accessibility>
                              <property name="label" translatable="yes">Select printer application from the internet</property>
                            </accessibility>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Select printer application from the internet:</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Option 3: Legacy driver -->
                <child>
                  <object class="GtkListBoxRow">
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="GtkCheckButton" id="option_legacy">
                            <property name="group">option_installed</property>
                            <accessibility>
                              <property name="label" translatable="yes">Select a classic driver for this printer</property>
                            </accessibility>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Select a classic driver for this printer (legacy)</property>
                                <property name="xalign">0</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Set up the printer with a classic CUPS driver</property>
                                <property name="xalign">0</property>
                                <style>
                                  <class name="dim-label"/>
                                  <class name="caption"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <!-- Bottom buttons -->
        <child>
          <object class="GtkBox">
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="web_interface_button">
                <property name="label" translatable="yes">Configure via web interface</property>
                <property name="sensitive" bind-source="option_installed" bind-property="active" bind-flags="sync-create"/>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="setup_button">
                <property name="label" translatable="yes">Set up printer</property>
                <style>
                  <class name="suggested-action"/>
                </style>
                <property name="hexpand">True</property>
                <property name="halign">end</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
